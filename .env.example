# ============================================
# STRAPI BACKEND CONFIGURATION
# ============================================

# Strapi API base URL. Booking requests are sent to POST {url}/appointments
# by the server route at /api/appointments, never directly from the browser.
VITE_STRAPI_API_URL=https://enduring-morning-cf86e59201.strapiapp.com/api

# Server-only overrides (no NEXT_PUBLIC_ prefix, so they are never sent to browsers).
# STRAPI_API_URL falls back to the value above when unset.
# STRAPI_API_URL=https://enduring-morning-cf86e59201.strapiapp.com/api

# Only needed if the "appointments" collection stops allowing public creates.
# Create a Strapi API token limited to "create" on appointments and set it in the
# hosting provider's environment settings. Do not commit a real value.
# STRAPI_API_TOKEN=


# ============================================
# SERVICE AREA
# ============================================

# Postcodes within this many miles of the Aldershot hub (or on the district list in
# src/data/locations.js) are reported as inside the service area. Default: 40.
# SERVICE_RADIUS_MILES=40


# ============================================
# Google Maps (legacy)
# ============================================

# The landing page no longer uses Google Maps: the coverage map and the booking map use
# Leaflet with OpenStreetMap tiles, which need no key.
# VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
